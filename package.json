{
  "name": "stratum-earth",
  "version": "0.4.0",
  "type": "module",
  "private": true,
  "description": "CUDA-authored compute Earth with WGS84 navigation, browser geographic streaming and constrained GPU seed farming.",
  "scripts": {
    "build": "node tools/compile.mjs && node tools/earth/build.mjs",
    "prestart": "npm run build",
    "start": "node server.mjs",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.mjs tests/earth/*.test.mjs && node tools/native-test.mjs",
    "test:source": "node --test tests/*.test.mjs tests/earth/*.test.mjs",
    "farm": "node tools/farm.mjs",
    "pages": "node tools/pages.mjs",
    "test:earth": "node --test tests/earth/*.test.mjs",
    "test:earth:gpu": "python tools/earth/browser-test.py"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "homepage": "https://samg-coder.github.io/STRATUM-EARTH/",
  "repository": {
    "type": "git",
    "url": "https://github.com/SamG-Coder/STRATUM-EARTH.git"
  }
}
